# Docker Compose environment for docker-compose.yaml.

PIPELINE_CODE_HOST_DIR=./demo-code
FED_SYSML_CODE_HOST_DIR=./demo-code

# Use linux/amd64 by default because several pipeline images are published for
# amd64. On Apple Silicon this lets Docker Desktop pull and run them through
# emulation instead of failing on missing arm64 manifests.
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Maps the legacy code path embedded in the bundled Enterprise Architect model
# to the repository's demo-code mount.
DTP_PATH_MAP=C:/Users/marco/Git-projects/anyFile/digital-twin-manager/lambda_functions/event_actions/stopCharging=/pipeline/code/microgrid/stopCharging

SIMULATOR_MOCK_AWS=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Comma-separated Grafana plugin IDs installed when local Grafana starts.
# Example: LOCAL_GRAFANA_PLUGINS=grafana-iot-twinmaker-app
LOCAL_GRAFANA_PLUGINS=grafana-iot-twinmaker-app
